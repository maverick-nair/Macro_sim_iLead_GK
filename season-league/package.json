{
  "name": "season-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Client Majlis: Season League. A self-running squad game prototype.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "import-content": "tsx scripts/import-content.ts",
    "validate-content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^14.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
