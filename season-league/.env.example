# Copy to .env. With no key the game runs in mock mode ("Demo AI").
ANTHROPIC_API_KEY=
# The Claude model id to use. Required for live mode; there is no default in code.
AI_MODEL=
# Server port for the API proxy (Vite proxies /api to it).
PORT=8787
# Demo mode adds the "Unlock now" switch on check in and seeds the demo squads.
DEMO_MODE=true
