{
  "$description": "Migration aliases. Variable names the ported screens and the Genie design system still read, mapped onto the token layers. Removed screen by screen as M1 to M6 move components to Tailwind utilities; must be empty by M8. `root` aliases are global defaults (the Genie dark brand); `theme` aliases are scoped to .il-theme, like the prototype's app root.",
  "root": {
    "font-sans": "{font.family.sans}",
    "grad-brand": "{gradient.brand}",
    "grad-spectrum": "{gradient.spectrum}"
  },
  "theme": {
    "ik-text": "{color.fg.primary}",
    "ik-text-2": "{color.fg.secondary}",
    "ik-card": "{color.surface.card}",
    "ik-raised": "{color.surface.raised}",
    "ik-line": "{color.line.default}",
    "ik-line-strong": "{color.line.strong}",
    "ik-track": "{color.track}",
    "ik-acc": "{color.accent.default}",
    "ik-acc-2": "{color.accent.secondary}",
    "ik-acc-soft": "{color.accent.soft}",
    "ik-on-acc": "{color.fg.on-accent}",
    "ik-warn": "{color.status.attention}",
    "ik-warn-soft": "{color.status.attention-soft}",
    "ik-pos": "{color.status.gain}",
    "ik-pos-soft": "{color.status.gain-soft}",
    "ik-neg": "{color.status.decline}",
    "ik-mat": "{color.surface.material}",
    "ik-scrim": "{color.surface.scrim}",
    "grad-brand": "{fill.brand}"
  }
}
