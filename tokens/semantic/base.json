{
  "$description": "Semantic layer. Meaning, per mode. Each color has a light and a dark value, emitted as light-dark() so color-scheme on the app root picks the mode. `alpha` applies an opacity to an OKLCH primitive. `themable` marks a token a GenieKreator theme may set at runtime (accents, the brand fill and surfaces; src/theme, D71). `contrast` declares a minimum WCAG 2.2 ratio against another semantic token, checked at build time.",
  "color": {
    "fg": {
      "primary": {
        "light": "{color.canvas.ink}",
        "dark": "{color.white}",
        "contrast": {
          "against": "color.surface.solid",
          "min": 4.5
        },
        "$description": "Names, values, headings"
      },
      "body": {
        "light": "{color.canvas.slate-700}",
        "dark": "{color.canvas.mist}",
        "contrast": {
          "against": "color.surface.solid",
          "min": 4.5
        },
        "$description": "Running text and labels on the canvas: a step softer than names and numbers, a step stronger than metadata (D227)"
      },
      "secondary": {
        "light": "{color.canvas.slate-600}",
        "dark": "{color.canvas.mist}",
        "contrast": {
          "against": "color.surface.solid",
          "min": 4.5
        },
        "$description": "Labels, metadata, descriptions"
      },
      "on-accent": {
        "light": "{color.white}",
        "dark": "{color.canvas.navy}",
        "$description": "Text on accent fills"
      }
    },
    "surface": {
      "page": {
        "light": "{color.canvas.paper}",
        "dark": "{color.canvas.navy}",
        "$description": "The page itself: paper, or navy on dark (D227). Sheets and panels that stand in for a page (the menu, the report) use it"
      },
      "card": {
        "light": "{color.white}",
        "dark": "{color.canvas.charcoal-900}",
        "themable": true,
        "$description": "Cards: white on paper, charcoal on navy (D227)"
      },
      "solid": {
        "light": "{color.white}",
        "dark": "{color.canvas.charcoal-950}",
        "themable": true,
        "$description": "Opaque card, fallback for translucent layers"
      },
      "raised": {
        "light": "{color.canvas.sand-200}",
        "dark": "{color.canvas.charcoal-850}",
        "themable": true,
        "$description": "Insets, segmented control tracks"
      },
      "material": {
        "light": "{color.canvas.paper-light}",
        "dark": "{color.canvas.charcoal-950}",
        "themable": true,
        "$description": "Overlays and drawers. Opaque in the canvas look: no glass (D227)"
      },
      "scrim": {
        "light": {
          "ref": "color.canvas.navy",
          "alpha": 0.45
        },
        "dark": {
          "ref": "color.canvas.navy",
          "alpha": 0.72
        },
        "$description": "Behind dialogs"
      }
    },
    "line": {
      "default": {
        "light": "{color.canvas.sand-300}",
        "dark": "{color.canvas.charcoal-800}",
        "$description": "Hairlines, decorative"
      },
      "strong": {
        "light": "{color.canvas.sand-400}",
        "dark": "{color.canvas.steel}",
        "$description": "Container borders: panels, dialogs, popovers. Decorative, the fill and shadow carry the edge"
      },
      "control": {
        "light": "{color.canvas.sand-600}",
        "dark": "{color.canvas.charcoal-600}",
        "$description": "Borders that identify a control: text fields, composers, choice chips, unearned star outlines. 3:1 against their surface (WCAG 1.4.11)"
      }
    },
    "track": {
      "light": "{color.canvas.sand-300}",
      "dark": "{color.canvas.charcoal-800}",
      "$description": "Empty part of bars and meters"
    },
    "accent": {
      "default": {
        "light": "{color.canvas.button}",
        "dark": "{color.canvas.mint}",
        "themable": true,
        "contrast": {
          "against": "color.surface.solid",
          "min": 3
        },
        "$description": "Bars, selected state, links. Navy on paper, mint on dark (D227)"
      },
      "secondary": {
        "light": "{color.canvas.button}",
        "dark": "{color.canvas.mint}",
        "themable": true,
        "contrast": {
          "against": "color.surface.solid",
          "min": 4.5
        },
        "$description": "Eyebrows, text links, icons, focus rings: navy on paper, mint on dark (D227). Used as 12px text, so it needs 4.5:1 (D8)"
      },
      "soft": {
        "light": "{color.canvas.sky-100}",
        "dark": {
          "ref": "color.canvas.mint",
          "alpha": 0.14
        },
        "themable": true,
        "$description": "Selected backgrounds"
      }
    },
    "status": {
      "attention": {
        "light": "{color.canvas.orange-800}",
        "dark": "{color.canvas.orange-300}",
        "contrast": {
          "against": "color.surface.solid",
          "min": 4.5
        },
        "$description": "Needs attention, under 30"
      },
      "attention-soft": {
        "light": "{color.canvas.orange-50}",
        "dark": {
          "ref": "color.canvas.orange-300",
          "alpha": 0.14
        }
      },
      "gain": {
        "light": "{color.canvas.green-800}",
        "dark": "{color.canvas.green-300}",
        "contrast": {
          "against": "color.surface.solid",
          "min": 4.5
        },
        "$description": "Positive delta"
      },
      "gain-soft": {
        "light": "{color.canvas.green-100}",
        "dark": {
          "ref": "color.canvas.green-300",
          "alpha": 0.14
        }
      },
      "decline": {
        "light": "{color.canvas.orange-800}",
        "dark": "{color.canvas.red-300}",
        "contrast": {
          "against": "color.surface.solid",
          "min": 4.5
        },
        "$description": "Negative delta"
      },
      "decline-soft": {
        "light": "{color.canvas.orange-50}",
        "dark": {
          "ref": "color.canvas.red-300",
          "alpha": 0.14
        }
      }
    },
    "button": {
      "solid": {
        "light": "{color.canvas.button}",
        "dark": "{color.canvas.paper-light}",
        "$description": "The primary button's fill: navy on paper, paper on dark (D227)"
      },
      "on-solid": {
        "light": "{color.white}",
        "dark": "{color.canvas.ink}",
        "$description": "The primary button's label: white on navy, ink on paper (D227). A client theme's brand fill brings its own (the loader picks deep space or white, whichever reads better on it)",
        "themable": true
      },
      "quiet": {
        "light": "{color.white}",
        "dark": {
          "ref": "color.white",
          "alpha": 0.04
        },
        "$description": "The outlined button: white on paper, nearly clear on dark (D227)"
      }
    }
  },
  "fill": {
    "brand": {
      "value": "linear-gradient({color.button.solid}, {color.button.solid})",
      "themable": true,
      "$description": "The primary button: flat navy on paper, flat paper on dark (D227, no gradients). A client theme sets its own brand gradient"
    },
    "product": {
      "value": "linear-gradient({color.accent.default}, {color.accent.default})",
      "$description": "Progress fills: flat (D227)"
    },
    "spectrum": {
      "value": "linear-gradient({color.accent.default}, {color.accent.default})",
      "$description": "Celebration: flat (D227)"
    }
  }
}
