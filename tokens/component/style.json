{
  "style": {
    "segment": {
      "transition": { "value": "background {duration.fast} {easing.brand}", "$description": "Selected letter fill" },
      "columns-touch": { "value": "repeat(3,minmax(0,1fr))", "$description": "Five or six letters on a touch screen wrap to rows of three, each a 44px target" }
    },
    "tooltip": {
      "bg": { "value": "{color.fg.primary}", "$description": "Inverted: the tooltip uses the text color as its fill" },
      "fg": { "value": "{color.fg.inverse}" },
      "shadow": { "value": "0 10px 30px {color.member.shadow-raised}" },
      "leading": { "value": "1.4", "$description": "Description line height" }
    }
  }
}
