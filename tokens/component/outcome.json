{
  "outcome": {
    "band": {
      "columns": { "value": "auto minmax(0,1.4fr) minmax(0,1fr) auto", "$description": "Portrait, what happened, who it affected, actions" },
      "shadow": { "value": "{shadow.outcome-glow}" },
      "enter": { "value": "ilIn {duration.slow} {easing.settle}" }
    },
    "portrait": {
      "ring": { "value": "0 0 0 3px {color.status.gain}", "$description": "The person the outcome is about" }
    },
    "eyebrow": {
      "tracking": { "value": "{tracking.eyebrow}" }
    },
    "headline": {
      "tracking": { "value": "{tracking.headline}" }
    }
  }
}
