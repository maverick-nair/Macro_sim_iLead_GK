{
  "button": {
    "radius": {
      "value": "{radius.pill}"
    },
    "font-weight": {
      "value": "{font.weight.700}"
    },
    "sm": {
      "height": {
        "value": "calc({space.unit} * 8)",
        "$description": "32px"
      },
      "padding-x": {
        "value": "calc({space.unit} * 3.5)",
        "$description": "14px"
      },
      "font-size": {
        "value": "{font.size.13}"
      }
    },
    "md": {
      "height": {
        "value": "calc({space.unit} * 10)",
        "$description": "40px"
      },
      "padding-x": {
        "value": "calc({space.unit} * 5)",
        "$description": "20px"
      },
      "font-size": {
        "value": "{font.size.14}"
      }
    },
    "lg": {
      "height": {
        "value": "calc({space.unit} * 12)",
        "$description": "48px"
      },
      "padding-x": {
        "value": "calc({space.unit} * 6.5)",
        "$description": "26px"
      },
      "font-size": {
        "value": "{font.size.15}"
      }
    },
    "primary": {
      "bg": {
        "value": "{fill.brand}"
      },
      "fg": {
        "value": "{color.brand.deep-space}"
      }
    },
    "secondary": {
      "bg": {
        "value": "{color.surface.raised}"
      },
      "fg": {
        "value": "{color.fg.primary}"
      },
      "border": {
        "value": "{color.line.strong}"
      }
    },
    "ghost": {
      "fg": {
        "value": "{color.fg.link}",
        "$description": "Light mode is darker than the brand blue so it passes on white and on the attention chip (D8)"
      },
      "fg-hover": {
        "value": "{color.fg.link-hover}"
      }
    }
  }
}
