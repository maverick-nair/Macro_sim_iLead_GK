{
  "button": {
    "radius": {
      "value": "{radius.4}",
      "$description": "4px corners, as on the approved canvas (D227)"
    },
    "font-weight": {
      "value": "{font.weight.600}"
    },
    "sm": {
      "height": {
        "value": "max(calc({space.unit} * 8), calc({font.size.13} * 1.6))",
        "$description": "32px; grows with the text size so a label at 200% fits (D56)"
      },
      "padding-x": {
        "value": "calc({space.unit} * 3.5)",
        "$description": "14px"
      },
      "font-size": {
        "value": "{font.size.13}"
      }
    },
    "md": {
      "height": {
        "value": "max(calc({space.unit} * 11), calc({font.size.14} * 1.6))",
        "$description": "44px, the canvas's control height and a full touch target (D227); grows with the text size"
      },
      "padding-x": {
        "value": "calc({space.unit} * 4)",
        "$description": "16px"
      },
      "font-size": {
        "value": "{font.size.14}"
      }
    },
    "lg": {
      "height": {
        "value": "max(calc({space.unit} * 13), calc({font.size.16} * 1.6))",
        "$description": "52px, the canvas's call to action (D227); grows with the text size"
      },
      "padding-x": {
        "value": "calc({space.unit} * 5.5)",
        "$description": "22px"
      },
      "font-size": {
        "value": "{font.size.16}"
      }
    },
    "primary": {
      "bg": {
        "value": "{fill.brand}"
      },
      "fg": {
        "value": "{color.button.on-solid}",
        "$description": "White on the navy button, ink on the paper button (D227)"
      }
    },
    "secondary": {
      "bg": {
        "value": "{color.button.quiet}",
        "$description": "White on paper, clear on dark, as the canvas draws its outlined buttons (D227)"
      },
      "fg": {
        "value": "{color.fg.primary}"
      },
      "border": {
        "value": "{color.line.strong}"
      }
    },
    "ghost": {
      "fg": {
        "value": "{color.fg.link}",
        "$description": "Light mode is darker than the brand blue so it passes on white and on the attention chip (D8)"
      },
      "fg-hover": {
        "value": "{color.fg.link-hover}"
      }
    }
  }
}
