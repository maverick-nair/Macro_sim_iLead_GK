{
  "liveshell": {
    "header": {
      "blur": { "value": "16px", "$description": "Backdrop blur behind the live header" }
    },
    "body": {
      "columns-brief": { "value": "300px minmax(0,1fr)", "$description": "Brief card, then the stage" },
      "columns-collapsed": { "value": "auto minmax(0,1fr)", "$description": "Show brief button, then the stage" }
    },
    "eyebrow": {
      "tracking": { "value": "{tracking.eyebrow}", "$description": "\"Your brief\" eyebrow" }
    },
    "tip": {
      "enter": { "value": "ilIn {duration.base} ease", "$description": "Coaching tip appearing in the brief" }
    },
    "roleplay": {
      "columns": { "value": "minmax(0,1.2fr) minmax(300px,1fr)", "$description": "Portrait and caption, then the transcript" },
      "transcript-max-height": { "value": "max(320px, calc(100dvh - 240px))", "$description": "A long transcript scrolls inside the window instead of growing the page. At 900 tall it is above the designed stage height, so the frames are unchanged" },
      "halo-frustrated": { "value": "conic-gradient(from 200deg, {color.liveshell.mood.frustrated}, transparent 40%, {color.liveshell.mood.frustrated} 70%, transparent)" },
      "halo-guarded": { "value": "conic-gradient(from 200deg, {color.liveshell.mood.guarded}, transparent 40%, {color.liveshell.mood.guarded} 70%, transparent)" },
      "halo-open": { "value": "conic-gradient(from 200deg, {color.liveshell.mood.open}, transparent 40%, {color.liveshell.mood.open} 70%, transparent)" },
      "halo-filter": { "value": "blur(10px)", "$description": "Soft mood ring behind the portrait" },
      "halo-transition": { "value": "background {duration.slow} ease", "$description": "Mood ring colour change (the design's 600ms, snapped to duration.slow)" },
      "portrait-transition": { "value": "border-color {duration.slow} ease" },
      "speaking-ring": { "value": "ilRing 1.6s ease-out infinite", "$description": "Pulse around the portrait while the NPC speaks" },
      "dot-1": { "value": "ilDot 1.2s infinite", "$description": "Thinking dots, staggered" },
      "dot-2": { "value": "ilDot 1.2s infinite .15s" },
      "dot-3": { "value": "ilDot 1.2s infinite .3s" }
    },
    "meeting": {
      "tile-glow": { "value": "0 0 30px {color.liveshell.speaking-glow}", "$description": "Active speaker halo" },
      "tile-transition": { "value": "border-color {duration.base} ease, box-shadow {duration.base} ease" },
      "tile-overlay": { "value": "linear-gradient(180deg, transparent 55%, {color.liveshell.tile-shade})" },
      "tile-position": { "value": "center 15%", "$description": "Keeps faces in frame in the 4:3 tile" }
    },
    "sponsor": {
      "fill": { "value": "linear-gradient(160deg,{color.brand.electric-blue},{color.brand.cyber-cyan} 60%,{color.brand.mint-green})", "$description": "Sponsor avatar backdrop" },
      "funnel-columns": { "value": "110px 1fr 54px", "$description": "Stage name, bar, count of ideal" }
    },
    "email": {
      "leading": { "value": "1.65", "$description": "Email body line height" }
    },
    "reply": {
      "listening-ring": { "value": "0 0 0 3px {color.liveshell.listening-ring}", "$description": "Reply bar while the mic listens" }
    },
    "reacting": {
      "title-tracking": { "value": "{tracking.title}" },
      "ring": { "value": "{liveshell.roleplay.speaking-ring}", "$description": "Pulse around each reacting face, as the speaking ring" },
      "stagger": { "value": "0.3s", "$description": "Delay between the faces' pulses" }
    }
  }
}
