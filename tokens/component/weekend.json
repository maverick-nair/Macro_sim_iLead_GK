{
  "weekend": {
    "enter": { "value": "ilIn {duration.slow} ease", "$description": "Report, unlock and news steps rise in" },
    "logo": {
      "tracking": { "value": "-0.03em" }
    },
    "glow": {
      "fill": { "value": "none", "$description": "No halo behind the banner headline (D227)" },
      "top": { "value": "45%", "$description": "The halo sits a little above the middle" }
    },
    "display": {
      "tracking": { "value": "-0.03em", "$description": "The 64px banner headline" }
    },
    "title": {
      "tracking": { "value": "-0.02em", "$description": "Unlock heading and news titles" }
    },
    "report": {
      "columns": { "value": "minmax(0,1.3fr) minmax(0,1fr)", "$description": "Funnel and team, then stars and the small cards" }
    },
    "funnel": {
      "columns": { "value": "minmax(130px, max-content) minmax(0,1fr) minmax(96px, max-content)", "$description": "Stage, bar, value. The text columns grow for large text (D56); at 100% they stay 130px and 96px (the mono value, D227)" },
      "tick": { "value": "2px", "$description": "The ideal marker on a funnel bar" }
    },
    "kpi": {
      "columns": { "value": "minmax(0,1fr) repeat(3, minmax(70px, max-content))", "$description": "Metric, start, change, end. The number columns grow for large text (D56)" }
    },
    "reward": {
      "columns": { "value": "repeat(3,280px)", "$description": "Three reward cards" },
      "lift": { "value": "translateY(-6px)", "$description": "The chosen reward card rises" },
      "transition": { "value": "transform {duration.base} ease", "$description": "The design's 200ms, snapped to duration.base (D24)" },
      "art-1": { "value": "linear-gradient({color.canvas.navy-800},{color.canvas.navy-800})" },
      "art-2": { "value": "linear-gradient({color.canvas.button},{color.canvas.button})" },
      "art-3": { "value": "linear-gradient({color.canvas.sky-100},{color.canvas.sky-100})" }
    },
    "news": {
      "art-blue": { "value": "linear-gradient({color.canvas.button},{color.canvas.button})", "$description": "Impact, capacity and diagnostic bulletins" },
      "art-mint": { "value": "linear-gradient({color.canvas.navy-800},{color.canvas.navy-800})", "$description": "Opportunity and signal bulletins" },
      "art-warm": { "value": "linear-gradient({color.canvas.orange-800},{color.canvas.orange-800})", "$description": "Crisis bulletins" }
    }
  }
}
