{
  "member": {
    "portrait": {
      "calm": { "value": "linear-gradient(160deg,{color.portrait.sky-100},{color.portrait.sky-300})", "$description": "Backdrop for steady, upbeat and thinking moods" },
      "strained": { "value": "linear-gradient(160deg,{color.portrait.sand-100},{color.portrait.sand-300})", "$description": "Backdrop for concerned and frustrated moods" },
      "away": { "value": "linear-gradient(160deg,{color.portrait.fog-100},{color.portrait.fog-300})", "$description": "Backdrop while the member is away" },
      "overlay": { "value": "linear-gradient(180deg, transparent 50%, {color.member.portrait-shade} 100%)" },
      "position": { "value": "center 12%", "$description": "Keeps faces in frame in the 118px portrait" }
    },
    "card": {
      "shadow": { "value": "0 6px 20px {color.member.shadow-rest}" },
      "shadow-selected": { "value": "0 0 0 1px {color.accent.secondary}, 0 12px 36px {color.member.glow}" },
      "transition": { "value": "translate {duration.base} {easing.settle}, box-shadow {duration.base} {easing.brand}, opacity {duration.base} {easing.brand}", "$description": "Hover lift, selection glow, picking dim" }
    }
  }
}
