{
  "title": "author-turn-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brief": {
      "type": "object",
      "properties": {
        "roleLevel": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "challenge": {
          "type": "string"
        },
        "client": {
          "type": [
            "string",
            "null"
          ]
        },
        "teamSize": {
          "type": "integer",
          "minimum": 6,
          "maximum": 12
        },
        "process": {
          "minItems": 3,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "duration": {
          "type": "string",
          "enum": [
            "full",
            "standard",
            "lite"
          ]
        },
        "region": {
          "type": "string",
          "enum": [
            "global",
            "us",
            "uk",
            "india",
            "singapore",
            "uae",
            "australia"
          ]
        },
        "language": {
          "type": "string"
        },
        "framework": {
          "type": [
            "string",
            "null"
          ]
        },
        "tone": {
          "type": "string",
          "enum": [
            "professional",
            "warm",
            "direct"
          ]
        },
        "documents": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "text"
            ]
          }
        },
        "stakeholders": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "role": {
                "type": "string",
                "maxLength": 200
              },
              "relation": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "name",
              "role",
              "relation"
            ]
          }
        },
        "objectives": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "dilemmas": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "a": {
                "type": "string",
                "maxLength": 200
              },
              "b": {
                "type": "string",
                "maxLength": 200
              },
              "stake": {
                "type": "string",
                "maxLength": 400
              }
            },
            "required": [
              "title",
              "a",
              "b",
              "stake"
            ]
          }
        }
      }
    },
    "asked": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "role_level",
          "industry",
          "challenge",
          "client",
          "team_size",
          "process",
          "duration",
          "language",
          "framework",
          "tone"
        ]
      }
    },
    "answers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "taken": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "role_level",
          "industry",
          "challenge",
          "client",
          "team_size",
          "process",
          "duration",
          "language",
          "framework",
          "tone"
        ]
      }
    }
  },
  "required": [
    "brief",
    "asked",
    "answers"
  ]
}
