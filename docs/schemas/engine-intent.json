{
  "title": "engine-intent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "confirmStyles"
        },
        "styles": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$"
          }
        },
        "notes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "styles"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "openProfile"
        },
        "memberId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "memberId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "planAction"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "option": {
          "type": "string",
          "minLength": 1
        },
        "memberIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "action",
        "memberIds"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "openConversation"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reply",
            "sponsor"
          ]
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "submitInteraction"
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "usedVoice": {
          "type": "boolean"
        },
        "npcReply": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "interactionId",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sendTurn"
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "usedVoice": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "interactionId",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "submitPlan"
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "object",
          "properties": {
            "goals": {
              "type": "string",
              "maxLength": 2000
            },
            "measures": {
              "type": "string",
              "maxLength": 2000
            },
            "owner": {
              "type": "string",
              "maxLength": 200
            },
            "due": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "support": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "goals",
            "measures",
            "owner",
            "due",
            "support"
          ]
        },
        "usedVoice": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "interactionId",
        "text",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "interruptTurn"
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "shownChars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "interactionId",
        "turnId",
        "shownChars"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "requestHint"
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "interactionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "nextCandidate"
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "interactionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chooseCandidate"
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        },
        "candidateId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "interactionId",
        "candidateId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "endInteraction"
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "interactionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "abandonInteraction"
        },
        "interactionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "interactionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "dismissCard"
        },
        "cardId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "cardId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "clearOutcome"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "endPeriod"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chooseReward"
        },
        "reward": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "reward"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "submitReflection"
        },
        "answers": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "rating": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "answers",
        "rating"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "startNextPeriod"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "startPractice"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "skipPractice"
        }
      },
      "required": [
        "type"
      ]
    }
  ]
}
