{
  "title": "engine-stream-chunk",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "token"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "done"
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "turnId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "retryable"
      ]
    }
  ]
}
