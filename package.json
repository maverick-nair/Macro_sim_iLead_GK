{
  "name": "ilead-participant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "tsx scripts/tokens/build.ts",
    "tokens:check": "tsx scripts/tokens/build.ts --check",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens:check && vitest run && tsc -b && vite build && tsx scripts/budget.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "parity": "tsx tests/visual/parity.ts",
    "lint:copy": "vitest run src/i18n/catalog.test.ts",
    "storybook:smoke": "storybook build -o storybook-static --quiet && tsx tests/visual/stories-smoke.ts storybook-static",
    "calibrate": "tsx scripts/calibrate.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tanstack/react-query": "^5.104.1",
    "intl-messageformat": "^12.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@playwright/test": "^1.56.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "culori": "^4.0.2",
    "pngjs": "^7.0.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
