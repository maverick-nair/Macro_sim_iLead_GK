{
  "name": "ilead-participant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "ai"
  ],
  "scripts": {
    "tokens": "tsx scripts/tokens/build.ts",
    "tokens:check": "tsx scripts/tokens/build.ts --check",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens:check && vitest run && tsc -b && vite build && tsx scripts/budget.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "parity": "tsx tests/visual/parity.ts",
    "lint:copy": "vitest run src/i18n/catalog.test.ts",
    "storybook:smoke": "storybook build -o storybook-static --quiet && tsx tests/visual/stories-smoke.ts storybook-static",
    "calibrate": "tsx scripts/calibrate.ts",
    "ai:calibrate": "tsx ai/scripts/calibrate.ts",
    "ai:persona-check": "tsx ai/scripts/persona-check.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "schemas": "tsx scripts/schemas.ts",
    "vitals": "tsx scripts/vitals.ts",
    "e2e": "playwright test",
    "lint": "eslint .",
    "dev:full": "tsx server/scripts/dev-full.ts",
    "build:server-app": "vite build --mode server --outDir dist-server",
    "server": "node --import tsx server/src/index.ts",
    "server:dev": "tsx watch --clear-screen=false server/src/index.ts",
    "server:migrate": "node --import tsx server/src/index.ts --migrate-only",
    "server:mint": "tsx server/scripts/mint.ts",
    "test:server": "vitest run --config server/vitest.config.ts",
    "e2e:server": "playwright test --config server/playwright.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tanstack/react-query": "^5.104.1",
    "@visx/axis": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/pattern": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "hono": "^4.13.13",
    "intl-messageformat": "^12.1.2",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "playwright-core": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@playwright/test": "^1.56.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "culori": "^4.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pg-mem": "^3.0.14",
    "pngjs": "^7.0.0",
    "smtp-server": "^3.19.17",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
