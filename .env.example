# Copy to .env. Names only: never commit values.
DATABASE_URL=postgresql://gk:gk@localhost:5432/gk?schema=public
REDIS_URL=redis://localhost:6379
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL_GENERATION=
LLM_MODEL_EVALUATOR=
LLM_MODEL_NPC=
LLM_MODEL_UTILITY=
LLM_MODEL_FAST=
LLM_MODEL_JUDGE=

# AI RolePlay app (apps/roleplay). The API server needs ANTHROPIC_API_KEY, LLM_MODEL_NPC and
# LLM_MODEL_JUDGE above; without them it answers with the offline providers.
ROLEPLAY_API_PORT=8787
ROLEPLAY_DUAL_PASS=0
VITE_AI_PROVIDER=mock
