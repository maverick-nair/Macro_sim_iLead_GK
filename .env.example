# Copy to .env.local. Leave a variable unset to use its in browser mock.

# Engine server for the playable board (EngineClient, src/engine/client.ts). Unset: the mock engine.
# VITE_ILEAD_ENGINE_URL=https://api.example.com/ilead/engine/v1

# Speech transcription server (src/speech). Unset: the scripted mock voice.
# VITE_ILEAD_SPEECH_URL=https://api.example.com/ilead/speech/v1

# App shell API: scenario, saved session, settings, prototype board (IleadApi, src/api). Unset: the in memory mock adapter.
# VITE_ILEAD_API_URL=https://api.example.com/ilead/v1

# GenieKreator author chat server (/author, src/author/drafter.ts). Unset: drafts from templates.
# VITE_GENIE_URL=https://api.example.com/genie/v1
