# iLead environment. Two parts: the APP's build time variables (VITE_*) and the SERVER's runtime variables.
# Never commit a filled in copy: secrets live in your secret store. docs/SERVER.md explains each one.

# ==================================================================================================
# App (build time, read by Vite). Copy to .env.local. Unset: the in browser mock for that service.
# `npm run build:server-app` and `npm run dev:full` use .env.server instead (same origin paths).
# ==================================================================================================

# Engine server for the playable board (EngineClient, src/engine/client.ts). Unset: the mock engine.
# VITE_ILEAD_ENGINE_URL=https://ilead.example.com/engine

# Speech transcription server (src/speech). Unset: the scripted mock voice.
# VITE_ILEAD_SPEECH_URL=https://ilead.example.com/speech

# App shell API: profile, theme, history, cohort, report PDF and email (IleadApi, src/api). Unset: the in memory mock adapter.
# VITE_ILEAD_API_URL=https://ilead.example.com/api

# GenieKreator author chat server (/author, src/author/drafter.ts). Unset: drafts from templates.
# VITE_GENIE_URL=https://ilead.example.com/genie

# ==================================================================================================
# Server (runtime, server/src/config.ts). Every variable is optional unless marked REQUIRED.
# ==================================================================================================

# --- Process ---
# NODE_ENV=production              # production turns on secure cookies and requires LAUNCH_SECRET
# PORT=8787
# HOST=0.0.0.0
# PUBLIC_URL=https://ilead.example.com   # the address participants open: launch redirects, PDF rendering
# APP_URL=                               # where the PDF renderer loads the app, when it differs from PUBLIC_URL
# STATIC_DIR=dist-server                 # serve the app's build from here (empty: the app is on a CDN)
# LOG_LEVEL=info                         # debug, info, warn, error, silent (JSON lines on stdout)
# TRUST_PROXY=false                      # true behind a load balancer: client address from X-Forwarded-For
# GIT_SHA=                               # optional, recorded with each run's engine version

# --- Storage ---
# DATABASE_URL=postgres://ilead:password@db:5432/ilead   # Postgres. Unset: SQLite at SQLITE_PATH
# DATABASE_POOL_MAX=10
# SQLITE_PATH=./data/ilead.sqlite

# --- Launch and sessions ---
# LAUNCH_SECRET=                  # REQUIRED in production: 32+ random characters, shared with the LMS / GenieKreator (HS256)
# LAUNCH_SECRET_PREVIOUS=         # comma separated older secrets still accepted while rotating
# LAUNCH_ISSUERS=                 # comma separated `iss` values accepted (empty: any issuer)
# LAUNCH_AUDIENCE=ilead           # the `aud` every launch token must carry
# LAUNCH_REDIRECT=/               # where a participant lands (the app adds ?participant=<id>)
# SESSION_COOKIE=ilead_session
# SESSION_TTL_HOURS=12
# COOKIE_SECURE=                  # default: true in production, false in development
# COOKIE_SAMESITE=Lax             # None (with HTTPS) when the app is embedded in an LMS frame on another site
# COOKIE_DOMAIN=
# ADMIN_TOKEN=                    # 32+ characters: `Authorization: Bearer <token>` for operators (every role, every cohort)

# --- HTTP ---
# CORS_ORIGINS=                   # comma separated origins allowed to call with credentials (app on a CDN)
# FRAME_ANCESTORS=                # comma separated origins that may embed the app (the LMS). Default: this site only
# RATE_LIMIT_AI_PER_MIN=30        # per caller: model calls (conversation turns, author chat, transcriptions)
# RATE_LIMIT_EMAIL_PER_HOUR=5     # per participant
# RATE_LIMIT_LAUNCH_PER_MIN=30    # per caller address
# BODY_LIMIT_KB=512
# AUDIO_CHUNK_LIMIT_KB=1024

# --- Engine ---
# ENGINE_CACHE_SIZE=500           # live engines kept in memory; the rest replay from the event log
# STREAM_TOKENS_PER_SEC=40        # pace of streamed NPC words (0: as fast as possible)
# DEFAULT_STORYLINE=sales_elevator
# CALIBRATION_CONCURRENCY=2       # synthetic player calibrations run at once, in process (POST /genie/calibrations)
# CALIBRATION_QUEUE=20            # calibrations that may wait; more answer 503 busy
# CALIBRATION_PER_OWNER=2         # calibrations one author may have queued or running; more answer 429 tooManyCalibrations
# CALIBRATION_TIME_LIMIT_MS=600000  # a calibration running longer is stopped and fails with timeLimit (0: no limit)

# --- AI (the ai/ module, docs/AI.md) ---
# AI_PROVIDER=                    # mock or anthropic. Default: anthropic when ANTHROPIC_API_KEY is set, else mock
# ANTHROPIC_API_KEY=              # the model's API key (secret store only)
# AI_MODULE=                      # the ai/ module's entry file, when it is not at ./ai
# The ai/ module reads its tuning from the same environment (docs/AI.md section 8), for example:
# AI_PROVIDER_NPC= AI_PROVIDER_EVALUATOR= AI_PROVIDER_AUTHOR=   # per role mock or anthropic
# AI_MODEL_NPC= AI_MODEL_EVALUATOR= AI_MODEL_AUTHOR=             # model ids (defaults in ai/src/config.ts)
# AI_EFFORT_NPC= AI_EFFORT_EVALUATOR= AI_EFFORT_AUTHOR=          # low, medium, high, xhigh, max
# AI_MAX_TOKENS_<ROLE>= AI_TEMPERATURE_<ROLE>= AI_TIMEOUT_MS_<ROLE>= AI_MAX_RETRIES= AI_MAX_RETRIES_<ROLE>=
# ANTHROPIC_BASE_URL= AI_REFUSAL_FALLBACK=true AI_PROMPT_CACHE=true AI_CACHE_TTL=5m AI_NPC_HOLD_BACK=sentence AI_REPAIR_RETRIES=1

# --- Speech ---
# SPEECH_PROVIDER=                # mock, http or off. Default: http when SPEECH_URL is set, else mock
# SPEECH_URL=                     # the speech to text service (docs/AI.md section 7)
# SPEECH_KEY=                     # its credential (secret store only)
# SPEECH_AUTH_HEADER=Authorization
# SPEECH_AUTH_SCHEME=Bearer
# SPEECH_TIMEOUT_MS=15000

# --- Report PDF (headless Chromium) ---
# PDF_ENABLED=true
# CHROMIUM_PATH=                  # a Chromium binary; empty: Playwright's (PLAYWRIGHT_BROWSERS_PATH)
# PDF_TIMEOUT_MS=30000
# PDF_CONCURRENCY=2

# --- Report email (SMTP). Unset: email is off (the app hides nothing; the endpoint answers 501) ---
# SMTP_URL=smtps://user:password@smtp.example.com:465   # or the fields below
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=iLead <no-reply@example.com>
# EMAIL_REPLY_TO=

# --- Benchmarks and retention ---
# BENCHMARK_REFRESH_HOURS=24      # recompute group report benchmarks from every stored run (0: on demand only)
# BENCHMARK_MIN_RUNS=20           # below this a lens keeps the sample benchmark
# RETENTION_DAYS=0                # delete runs untouched this long (0: keep). Expired sessions are always removed
