# Copy to .env. Names only: never commit values.
DATABASE_URL=postgresql://gk:gk@localhost:5432/gk?schema=public
REDIS_URL=redis://localhost:6379
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL_GENERATION=
LLM_MODEL_EVALUATOR=
LLM_MODEL_NPC=
LLM_MODEL_UTILITY=
LLM_MODEL_FAST=
LLM_MODEL_JUDGE=

# AI RolePlay app (apps/roleplay). The browser reads VITE_AI_PROVIDER (mock = fully offline, http = call
# the API server). The server routes each job on its own: LLM_ROUTE_<JOB>=provider:model[:effort], with
# provider one of anthropic, bedrock, vertex or mock; jobs without a route use LLM_ROUTE_DEFAULT. No model
# id is committed here. LLM_AUTH_MODE=env lets the SDK resolve credentials (ANTHROPIC_API_KEY above, or a
# bearer token); gateway sends no credential and relies on ANTHROPIC_BASE_URL. See apps/roleplay/HANDOVER.md.
VITE_AI_PROVIDER=mock
ROLEPLAY_API_PORT=8787
ROLEPLAY_DUAL_PASS=0
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_LOG_USAGE=1
LLM_AUTH_MODE=env
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
LLM_GATEWAY_HEADERS=
LLM_BEDROCK_REGION=
LLM_VERTEX_REGION=
LLM_VERTEX_PROJECT_ID=
LLM_ROUTE_DEFAULT=mock
LLM_ROUTE_NPC=
LLM_ROUTE_CLASSIFY=
LLM_ROUTE_REPORT=
LLM_FALLBACK_NPC=
LLM_FALLBACK_CLASSIFY=
LLM_FALLBACK_REPORT=
PROMPT_VERSION_NPC=v1
PROMPT_VERSION_CLASSIFY=v1
PROMPT_VERSION_REPORT=v1
