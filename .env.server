# The app built or served against the reference server (server/, docs/SERVER.md): `vite --mode server`,
# `npm run build:server-app` and `npm run dev:full` load this file. Paths are relative, so the same build
# works on any host that serves the app and the server on one origin (the server's STATIC_DIR, or a
# CDN or reverse proxy routing these prefixes to the server). For separate origins, build with full URLs
# instead (and set the server's CORS_ORIGINS and COOKIE_SAMESITE=None).
VITE_ILEAD_ENGINE_URL=/engine
VITE_ILEAD_API_URL=/api
VITE_ILEAD_SPEECH_URL=/speech
VITE_GENIE_URL=/genie
